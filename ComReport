import os
import platform
import socket
import subprocess
import json
from datetime import datetime

import psutil

from tkinter import Tk
from tkinter.filedialog import asksaveasfilename

from reportlab.pdfgen import canvas
from reportlab.pdfbase import pdfmetrics
from reportlab.pdfbase.ttfonts import TTFont


# =========================================================
# TÜRKÇE KARAKTER DESTEKLİ FONT
# =========================================================

FONT_PATHS = [
    r"C:\Windows\Fonts\arial.ttf",
    r"C:\Windows\Fonts\segoeui.ttf",
    r"C:\Windows\Fonts\DejaVuSans.ttf"
]

FONT_PATH = None

for path in FONT_PATHS:
    if os.path.exists(path):
        FONT_PATH = path
        break

if FONT_PATH:
    pdfmetrics.registerFont(
        TTFont("TurkceFont", FONT_PATH)
    )


# =========================================================
# İŞLETİM SİSTEMİ
# =========================================================

def get_os():

    system = platform.system()

    if system == "Windows":

        try:
            build = int(
                platform.version().split(".")[-1]
            )

            if build >= 22000:
                return "Windows 11"

            return "Windows 10"

        except:
            return "Windows"

    elif system == "Darwin":
        return "macOS"

    elif system == "Linux":
        return "Linux"

    return system


# =========================================================
# GPU BİLGİLERİ
# =========================================================

def get_gpu():

    gpus = []

    try:

        command = [
            "powershell",
            "-Command",
            """
            Get-CimInstance Win32_VideoController |
            Select-Object Name,AdapterRAM,DriverVersion,
            CurrentRefreshRate,CurrentHorizontalResolution,
            CurrentVerticalResolution |
            ConvertTo-Json
            """
        ]

        result = subprocess.check_output(
            command,
            text=True,
            encoding="utf-8",
            errors="ignore"
        )

        data = json.loads(result)

        if isinstance(data, dict):
            data = [data]

        for gpu in data:

            name = gpu.get(
                "Name",
                "Bilinmiyor"
            )

            adapter_ram = gpu.get(
                "AdapterRAM"
            )

            if adapter_ram:
                vram = (
                    adapter_ram /
                    (1024 ** 3)
                )

                vram_text = f"{vram:.2f} GB"

            else:
                vram_text = "Bilinmiyor"

            driver = gpu.get(
                "DriverVersion",
                "Bilinmiyor"
            )

            refresh = gpu.get(
                "CurrentRefreshRate",
                "Bilinmiyor"
            )

            width = gpu.get(
                "CurrentHorizontalResolution",
                "?"
            )

            height = gpu.get(
                "CurrentVerticalResolution",
                "?"
            )

            gpus.append({
                "Ad": name,
                "VRAM": vram_text,
                "Sürücü": driver,
                "Yenileme": f"{refresh} Hz",
                "Çözünürlük": f"{width} x {height}"
            })

    except Exception:

        gpus.append({
            "Ad": "GPU bilgisi alınamadı",
            "VRAM": "-",
            "Sürücü": "-",
            "Yenileme": "-",
            "Çözünürlük": "-"
        })

    return gpus


# =========================================================
# WI-FI
# =========================================================

def get_wifi():

    try:

        result = subprocess.check_output(
            ["netsh", "wlan", "show", "interfaces"],
            text=True,
            encoding="utf-8",
            errors="ignore"
        )

        for line in result.splitlines():

            line = line.strip()

            if line.startswith("SSID") and "BSSID" not in line:

                return line.split(":", 1)[1].strip()

        return "Wi-Fi bağlı değil"

    except:

        return "Wi-Fi bilgisi alınamadı"


# =========================================================
# IP ADRESİ
# =========================================================

def get_ip():

    try:

        hostname = socket.gethostname()

        return socket.gethostbyname(
            hostname
        )

    except:

        return "Bilinmiyor"


# =========================================================
# SİSTEM BİLGİLERİ
# =========================================================

def get_system_info():

    ram = psutil.virtual_memory()

    disk = psutil.disk_usage(
        os.path.abspath(os.sep)
    )

    info = {

        "Bilgisayar Adı":
            platform.node(),

        "İşletim Sistemi":
            get_os(),

        "İşletim Sistemi Sürümü":
            platform.version(),

        "İşlemci":
            platform.processor(),

        "Fiziksel Çekirdek":
            str(
                psutil.cpu_count(
                    logical=False
                )
            ),

        "Mantıksal Çekirdek":
            str(
                psutil.cpu_count()
            ),

        "CPU Kullanımı":
            f"%{psutil.cpu_percent(interval=1)}",

        "RAM Toplam":
            f"{ram.total / (1024 ** 3):.2f} GB",

        "RAM Kullanılan":
            f"{ram.used / (1024 ** 3):.2f} GB",

        "RAM Boş":
            f"{ram.available / (1024 ** 3):.2f} GB",

        "RAM Kullanımı":
            f"%{ram.percent}",

        "Disk Toplam":
            f"{disk.total / (1024 ** 3):.2f} GB",

        "Disk Kullanılan":
            f"{disk.used / (1024 ** 3):.2f} GB",

        "Disk Boş":
            f"{disk.free / (1024 ** 3):.2f} GB",

        "Disk Kullanımı":
            f"%{disk.percent}",

        "Wi-Fi":
            get_wifi(),

        "IP Adresi":
            get_ip()
    }

    return info


# =========================================================
# TERMİNAL RAPORU
# =========================================================

def print_report(info, gpus):

    print()
    print("=" * 60)
    print("                     COMREPORT")
    print("=" * 60)

    for key, value in info.items():

        print(
            f"{key:<28}: {value}"
        )

    print()
    print("GPU BİLGİLERİ")
    print("-" * 60)

    for gpu in gpus:

        print(
            f"Ekran Kartı : {gpu['Ad']}"
        )

        print(
            f"VRAM        : {gpu['VRAM']}"
        )

        print(
            f"Sürücü      : {gpu['Sürücü']}"
        )

        print(
            f"Yenileme    : {gpu['Yenileme']}"
        )

        print(
            f"Çözünürlük  : {gpu['Çözünürlük']}"
        )

        print("-" * 60)


# =========================================================
# PDF OLUŞTURMA
# =========================================================

def save_pdf(info, gpus):

    root = Tk()
    root.withdraw()

    file_path = asksaveasfilename(
        title="PC Raporunu Kaydet",
        defaultextension=".pdf",
        filetypes=[
            ("PDF Dosyası", "*.pdf")
        ]
    )

    root.destroy()

    if not file_path:

        print()
        print("PDF kaydetme iptal edildi.")

        return

    pdf = canvas.Canvas(
        file_path
    )

    pdf.setTitle(
        "ComReport"
    )

    # Font seç
    if FONT_PATH:

        normal_font = "TurkceFont"
        bold_font = "TurkceFont"

    else:

        normal_font = "Helvetica"
        bold_font = "Helvetica-Bold"

    # -----------------------------------------------------
    # BAŞLIK
    # -----------------------------------------------------

    y = 800

    pdf.setFont(
        bold_font,
        22
    )

    pdf.drawString(
        50,
        y,
        "COMREPORT"
    )

    y -= 35

    pdf.setFont(
        normal_font,
        10
    )

    pdf.drawString(
        50,
        y,
        "Bilgisayar Sistem Raporu"
    )

    y -= 20

    pdf.drawString(
        50,
        y,
        "Oluşturulma: " +
        datetime.now().strftime(
            "%d.%m.%Y %H:%M"
        )
    )

    y -= 40

    # -----------------------------------------------------
    # SİSTEM BİLGİLERİ
    # -----------------------------------------------------

    pdf.setFont(
        bold_font,
        14
    )

    pdf.drawString(
        50,
        y,
        "SİSTEM BİLGİLERİ"
    )

    y -= 25

    pdf.setFont(
        normal_font,
        10
    )

    for key, value in info.items():

        pdf.drawString(
            50,
            y,
            f"{key}: {value}"
        )

        y -= 20

        if y < 60:

            pdf.showPage()

            y = 800

            pdf.setFont(
                normal_font,
                10
            )

    # -----------------------------------------------------
    # GPU
    # -----------------------------------------------------

    y -= 15

    pdf.setFont(
        bold_font,
        14
    )

    pdf.drawString(
        50,
        y,
        "GPU BİLGİLERİ"
    )

    y -= 25

    pdf.setFont(
        normal_font,
        10
    )

    for gpu in gpus:

        gpu_lines = [

            f"Ekran Kartı: {gpu['Ad']}",

            f"VRAM: {gpu['VRAM']}",

            f"Sürücü: {gpu['Sürücü']}",

            f"Yenileme: {gpu['Yenileme']}",

            f"Çözünürlük: {gpu['Çözünürlük']}"
        ]

        for line in gpu_lines:

            pdf.drawString(
                50,
                y,
                line
            )

            y -= 20

        y -= 10

    # -----------------------------------------------------
    # PDF'Yİ KAYDET
    # -----------------------------------------------------

    pdf.save()

    print()
    print("PDF başarıyla oluşturuldu!")
    print()
    print("Dosya:")
    print(file_path)


# =========================================================
# ANA PROGRAM
# =========================================================

def main():

    print()
    print("ComReport başlatılıyor...")
    print()

    info = get_system_info()

    gpus = get_gpu()

    print_report(
        info,
        gpus
    )

    print()
    print("[1] PDF olarak kaydet")
    print("[2] Çıkış")

    choice = input(
        "\nSeçiminiz: "
    )

    if choice == "1":

        save_pdf(
            info,
            gpus
        )

    elif choice == "2":

        print(
            "\nProgram kapatılıyor..."
        )

    else:

        print(
            "\nGeçersiz seçim."
        )


# =========================================================
# BAŞLAT
# =========================================================

if __name__ == "__main__":
    main()
